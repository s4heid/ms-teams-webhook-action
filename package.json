{
  "name": "ms-teams-webhook-action",
  "version": "1.0.0",
  "description": "Send customizable CI/CD notifications to MS Teams via authenticated Power Automate webhook",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src __tests__",
    "lint:fix": "eslint src __tests__ --fix",
    "format": "prettier --write src __tests__",
    "format:check": "prettier --check src __tests__",
    "all": "npm run format && npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "github-action",
    "ms-teams",
    "notifications",
    "ci-cd",
    "webhook"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/http-client": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jest": "^29.17.1",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "rollup": "^4.68.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "ts-jest": "^29.4.15",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "test-exclude": {
      "minimatch": "^11.0.5"
    }
  }
}
